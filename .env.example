# ----------------------------------------------------------------------------
# stock-news-app environment template
# Copy this file to `.env.local` and fill in your own values. DO NOT commit
# `.env.local` — it is git-ignored.
# ----------------------------------------------------------------------------

# Postgres connection string. On Vercel use the Vercel Postgres / Neon URL.
# Locally you can point at a Docker Postgres or a remote dev database.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME"

# ============================================================================
# 大模型配置 (Universal OpenAI-compatible LLM Configuration)
# ============================================================================
# 支持任意兼容 OpenAI 接口规范的大模型服务（例如 OpenAI、DeepSeek、Ollama、OneAPI、Qwen、Claude Proxy 等）
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.2"
LLM_MAX_TOKENS="800"
LLM_TIMEOUT_MS="20000"
LLM_MAX_RETRIES="3"

# 向下兼容配置：若未配置 LLM_API_KEY，且配置了 DEEPSEEK_API_KEY，将自动回退映射至 deepseek-chat
DEEPSEEK_API_KEY=""

# ============================================================================
# 多资讯源适配器开关 (Plug & Play News Sources)
# ============================================================================
# 逗号分隔的资讯源列表。可选值：finnhub, googlenews, yahoo, eastmoney, cls, sina
# 未配置此项时，默认启用所有已注册的可用资讯源
ENABLED_NEWS_SOURCES="googlenews,yahoo,finnhub,eastmoney,cls,sina"

# Finnhub API key — used for US company news and quote fallback.
# Get one at: https://finnhub.io/register  (free tier: 60 req/min)
FINNHUB_API_KEY=""

# ============================================================================
# 智能体集成与任务调度安全鉴权 (Hermes & Cron Secrets)
# ============================================================================
# Hermes 开放 API Bearer Token 鉴权密钥。
# 当设置该项时，所有 /api/v1/hermes/* 请求须携带请求头 `Authorization: Bearer <HERMES_API_KEY>`
HERMES_API_KEY=""

# 定时调度任务密钥，保护 /api/cron/fetch-news
CRON_SECRET=""
